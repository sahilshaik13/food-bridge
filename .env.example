# FoodBridge split-project cloud configuration.
# Copy to .env.local for local development and point the credential paths at
# your local JSON files. Do not commit .env.local or service account JSON.

# Firebase-facing project: Auth, Firestore, Realtime Database, Storage.
FIREBASE_PROJECT_ID=foodbridge-4f96f
FIREBASE_ADMIN_CREDENTIALS=D:/food-bridge/foodbridge-4f96f-firebase-adminsdk-fbsvc-13dae4f785.json
FIREBASE_DATABASE_URL=https://foodbridge-4f96f-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_STORAGE_BUCKET=foodbridge-4f96f.firebasestorage.app
FIRESTORE_SYNC_ENABLED=true

# GCP-facing project: Cloud Run, Vertex AI, Pub/Sub, Tasks, BigQuery, Scheduler, Secret Manager.
GOOGLE_CLOUD_PROJECT=foodbridge-494704
GOOGLE_APPLICATION_CREDENTIALS=D:/food-bridge/foodbridge-494704-9ab3eee768a5.json
GCP_REGION=asia-south1
GCP_LOCATION=asia-south1
VERTEX_AI_LOCATION=global
# Phase 2 scan lineage (stored on Donation.scan + scan_contract_version). See backend/docs/phase2_scan_metadata_migration.md
VERTEX_AI_MODEL_ID=gemini-3-flash-preview
VERTEX_AI_MODEL_VERSION=preview
# Phase 3: Vertex JSON accuracy assessment on donation create (falls back to heuristic if false or errors).
ACCURACY_VERTEX_ENABLED=true
# PRD: Gemini re-ranks heuristic NGO queue (disable if latency-sensitive).
MATCHING_VERTEX_ENABLED=true
# PRD: queue NGO matching on Pub/Sub (set PUBSUB_MATCHING_INLINE_COMPLETION=false in prod with run_matching_subscriber).
PUBSUB_MATCHING_ENABLED=false
PUBSUB_MATCHING_INLINE_COMPLETION=true
# Emergency pool: Gemini ranks donors + personalised pledge copy (falls back if disabled or errors).
EMERGENCY_VERTEX_ENABLED=true
EMERGENCY_DONOR_NOTIFY_CAP=25
# V3 surplus predictions: optional BigQuery aggregates (requires ML export table + data).
V3_PREDICTION_BIGQUERY_ENABLED=false
SURPLUS_PRE_ALERT_ENABLED=true
SURPLUS_PRE_ALERT_PROBABILITY_FLOOR=0.72
SURPLUS_PRE_ALERT_RADIUS_KM=16
# Optional: protect POST /jobs/surplus-pre-alert (Cloud Scheduler).
# SCHEDULER_JOB_SECRET=

# Municipal heatmap: coverage gap = high-beneficiary NGO with no donor within this radius (km).
HEATMAP_GAP_RADIUS_KM=5
HEATMAP_GAP_MIN_BENEFICIARIES=40

# Phase 6: stream donation ML training rows to BigQuery (dataset/table auto-created on first insert).
ML_EXPORT_TO_BIGQUERY=false
BIGQUERY_ML_DATASET=foodbridge_ml
BIGQUERY_ML_TABLE=donation_training_events
TIMER_ACCELERATION=10
FRONTEND_BASE_URL=http://localhost:3000

# Cloud Run / prod: comma-separated extra allowed browser origins for CORS (defaults include localhost + known hosts in code).
# CORS_ALLOW_ORIGINS=https://your-app.example.com
#
# Deploy (GCP): sync secrets from this file, then build+deploy API+web to Cloud Run — see backend/docs/deploy_cloud_run.md
#   .\scripts\sync_env_to_gcp_secrets.ps1 -EnvFile .env.local -GrantIam
#   .\scripts\deploy_foodbridge_cloud_run.ps1 -SyncSecrets -GrantSecretIam -EnvFile .env.local

# Optional: OpenWeatherMap Current Weather API — enriches donations with outdoor temp/conditions near the venue for AI accuracy scoring (https://openweathermap.org/api).
# OPENWEATHERMAP_API_KEY=

# Frontend-safe Firebase Web App values.
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=foodbridge-4f96f.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://foodbridge-4f96f-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=foodbridge-4f96f
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=foodbridge-4f96f.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=507153921282
NEXT_PUBLIC_FIREBASE_APP_ID=1:507153921282:web:fb3739f1e8e01adba0be1b
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-N37VKGNTKJ
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_TIMER_ACCELERATION=10

# Optional Telegram main bot config. Store in Secret Manager for deployed Cloud Run.
TELEGRAM_MASTER_BOT_TOKEN=
TELEGRAM_MASTER_SECRET=
TELEGRAM_SLAVE_WEBHOOK_BASE_URL=
REPORT_VERIFY_SECRET=
REPORT_VERIFY_BASE_URL=

# Optional SMTP invite email config.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: disable external AI calls for local testing. Scan still records model_id/version from above with fallback_used=true.
DISABLE_AI_INTEGRATION=true
# When true (default), POST/PATCH /donations must use multipart with food photo for Gemini Vision.
REQUIRE_DONATION_PHOTO_FOR_HTTP=true
# Escalation waves: disable Cloud Tasks enqueue if the queue is not created locally (avoids 404 spam).
# ESCALATION_CLOUD_TASKS_ENABLED=false
